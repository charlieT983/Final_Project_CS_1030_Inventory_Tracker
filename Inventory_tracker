

#---------Remove item Functin--------------
def RemoveItem(paramList, paramItem):
    for entry in paramList:
        if entry[0] == paramItem:
            if entry[1] > 1:
                print("you have", entry[1], paramItem + ". how many do want to remove?")
                localAmount = ItemAmount(paramItem)
                while localAmount > entry[1]:
                    print("you only have", entry[1], paramItem)
                    localAmount = ItemAmount(paramItem)
                entry[1] = entry[1] - localAmount
                if entry[1] == 0:
                    paramList.remove(entry)
                    print("all of the", paramItem, "was removed")
                else:
                    print(localAmount, paramItem, "was removed. you now have", entry[1])
            else:
                paramList.remove(entry)
                print(paramItem, "was removed")
            return paramList
    print(paramItem, "is not in the inventory")
    return paramList




#-------Add item function-------
def AddItem(paramList, paramItem, paramAmount):
    for entry in paramList:
        if entry[0] == paramItem:
            entry[1] = entry[1] + paramAmount
            print(paramAmount, "more", paramItem, "added. you now have", entry[1])
            return paramList
    paramList.append([paramItem, paramAmount])
    print(paramAmount, paramItem, "was added")
    return paramList
    
        


#------Item Amount---------
def ItemAmount(paramItem):
    localAmount = input("enter the amount of " + paramItem + ":")
    while not localAmount.isdigit():            #this checks if the amount entered is a digit
        print("Please enter a whole number")
        localAmount = input("enter the amount of " + paramItem + ":")
    return int(localAmount)    #turns the value into an integer

            
