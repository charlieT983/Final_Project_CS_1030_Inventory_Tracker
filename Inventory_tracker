import csv

#---------Remove item Functin--------------
def RemoveItem(paramList, paramItem):
    for entry in paramList:
        if entry[0] == paramItem:
            if entry[1] > 1:
                print("you have", entry[1], paramItem + ". how many do want to remove?")
                localAmount = ItemAmount(paramItem)
                while localAmount > entry[1]:       #can't remove more than you have
                    print("you only have", entry[1], paramItem)
                    localAmount = ItemAmount(paramItem)
                entry[1] = entry[1] - localAmount
                if entry[1] == 0:
                    paramList.remove(entry)
                    print("all of the", paramItem, "was removed")
                else:
                    print(localAmount, paramItem, "was removed. you now have", entry[1])
            else:
                paramList.remove(entry)               #if you only have one left it will remove it completely 
                print(paramItem, "was removed")
            return paramList
    print(paramItem, "is not in the inventory")
    return paramList




#-------Add item function-------
def AddItem(paramList, paramItem, paramAmount):
    for entry in paramList:
        if entry[0] == paramItem:
            entry[1] = entry[1] + paramAmount
            print(paramAmount, "more", paramItem, "added. you now have", entry[1])
            return paramList
    paramList.append([paramItem, paramAmount])
    print(paramAmount, paramItem, "was added")
    return paramList
    
        


#------Item Amount---------
def ItemAmount(paramItem):
    localAmount = input("enter the amount of " + paramItem + ":")
    while not localAmount.isdigit():            #this checks if the amount entered is a digit
        print("Please enter a whole number")
        localAmount = input("enter the amount of " + paramItem + ":")
    return int(localAmount)    #turns the value into an integer


#------Set Low Amount------------
def SetLowAmount():
    localLow = input("at what amount is an item considered low in stock?:")
    while not localLow.isdigit():
        print("please enter a number")
        localLow = input("at what amount is an item considered low in stock?:")
    return int(localLow)



#------------Check Low Stock-------------------
def CheckLowStock(paramList, paramLowAmount):
    foundLow = False
    for entry in paramList:
        if entry[1] <= paramLowAmount:
            print(entry[0], "is low in stock. you only have", entry[1])
            foundLow = True
    if foundLow == False:
        print("nothing is low in stock")



#------------Load inventory----------
def LoadInventory(paramFileName):
    localList = []
    try:          #this tries the indented code and if FileNot FoundError then it will jump straight to the except
        with open(paramFileName, "r", newline="") as file:          #opens the file for reading. with just closes the file automatically
            #newline lets the csv module handle line endings itself. which you need on windows 
            #reader = csv.reader(file) makes a reader that goes through the file one row at a time
            reader = csv.reader(file)
            next(reader)        #next(reader) moves the reader past the first rowwithout using it.

            for row in reader: #this loops through every rowafter the header.
                if len(row) >= 2 and row[0] != "": #this only uses a row if it has at least 2 columns and the name isn't blank
                    localList.append([row[0], int(row[1])])
    except FileNotFoundError:   #this only runs if the file doesn't exist, this happens when you first run the code because the list is blank
        #note: using "try" you need a except. if you don't have that then the code won't run 
        print("no inventory file found, starting with an empty inventory")
    return localList

#--------------Save Inventory----------
def SaveInventory(paramList, paramFileName):
    with open(paramFileName, "w", newline="") as file: # opens the file for writing. This creates the file if it doesn't exist
        #if it does exist then it will erase the old contents first
        writer = csv.writer(file)   # this makes a writer that turns lists into comma separated lines in the file 
        writer.writerow(["item", "amount"])     # this writes the header row. these become the column titles in excel 
        for entry in paramList: # this for loops through each item and amount in the inventory 
            writer.writerow(entry)  #this writes one item as one row
    print("inventory Saved to",paramFileName)
# there is no return because this just saves the content into the file 



#----------Main--------------
myList = LoadInventory("inventory.csv")
print("Inventory:", myList)
lowAmount = SetLowAmount()
userChoice = input("Do you want to add, remove, or check what is low? (add/remove/low/done):".lower())

while userChoice != "done":
    if userChoice == "add":
        item = input("enter the item you want to add:")
        amount = ItemAmount(item)
        myList = AddItem(myList, item, amount)
    elif userChoice == "remove":
        item = input("enter the item you want to remove:")
        myList = RemoveItem(myList, item)
    elif userChoice == "low":
        CheckLowStock(myList, lowAmount)
    else:
        print("please type done or (add), (remove)")

    print("Inventory:", myList)
    userChoice = input("Do you want to add, remove, or check? (add/remove/low/done):".lower())

SaveInventory(myList, "inventory.csv")
print("Final Inventory:", myList)

















